# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=akt_tutor

# SBERT Embedding Model Path (Local fine-tuned model directory or Hugging Face identifier)
SBERT_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2

# Code Execution Sandbox Mode (0 = Docker ephemeral sandbox enabled, 1 = offline fallback)
SANDBOX_OFFLINE=0

# Internal Service Authentication (Shared secret between FastAPI and Next.js BFF)
# Minimum 32 characters (e.g. generated via `openssl rand -hex 32`)
INTERNAL_SERVICE_SECRET=replace_with_a_secure_random_service_secret_at_least_32_chars
