# FastAPI Backend Base URL (Server-Only loopback call from Next.js BFF)
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Legacy / Client API Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Internal Service Authentication Secret (Must match INTERNAL_SERVICE_SECRET in FastAPI backend)
# Minimum 32 characters, never prefix with NEXT_PUBLIC_
INTERNAL_SERVICE_SECRET=replace_with_a_secure_random_service_secret_at_least_32_chars

# Server-Only JWT Session Secret (Must never be prefixed with NEXT_PUBLIC_)
# Minimum 32 characters, used to sign and verify student session cookies
JWT_SECRET=replace_with_a_secure_random_server_secret_at_least_32_chars
